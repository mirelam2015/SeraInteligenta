<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SeraInteligenta.WPF</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Containerul de IoC -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeraInteligenta.Core\SeraInteligenta.Core.csproj" />
    <ProjectReference Include="..\SeraInteligenta.Infrastructure\SeraInteligenta.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fișierele de date există o singură dată, în folderul Date din rădăcina soluției,
         și sunt copiate lângă .exe la fiecare build. -->
    <None Include="..\Date\*.json" Link="Date\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
