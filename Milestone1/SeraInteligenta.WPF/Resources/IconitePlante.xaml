<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Iconițe vectoriale desenate pentru acest proiect (fără imagini externe, deci fără probleme de licență).
        Fiecare are o cutie de 24 × 24; dreptunghiul transparent din primul rând păstrează spațiul dintre plante
        când iconița e repetată pe parcelă. Cheia este „Icon.” + IdPlanta din plante_catalog.json.
    -->

    <DrawingImage x:Key="Icon.generic">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Brush="#7CB342" Geometry="M12,5 C17,8 17,15 12,19 C7,15 7,8 12,5 Z"/>
                <GeometryDrawing Geometry="M12,7 L12,18">
                    <GeometryDrawing.Pen><Pen Brush="#33691E" Thickness="1"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Roșie: fruct roșu cu caliciu verde -->
    <DrawingImage x:Key="Icon.rosii">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Brush="#E53935">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="12,13.5" RadiusX="6.5" RadiusY="6"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#EF9A9A">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="9.5,11.5" RadiusX="1.5" RadiusY="1.2"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#43A047" Geometry="M12,9 L9,7 L11,8.5 L10,6 L12,8 L14,6 L13,8.5 L15,7 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

