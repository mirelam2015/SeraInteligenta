<Window x:Class="SeraInteligenta.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sera Inteligentă – Milestone 1"
        Width="1400" Height="880" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource Brush.Text}"
        Background="{StaticResource Brush.Fundal}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Antet ================= -->
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Citire automată senzori" IsChecked="{Binding CitireAutomata}"
                          VerticalAlignment="Center" Margin="0,0,10,0"
                          ToolTip="Citește toți senzorii la fiecare 2 secunde"/>
                <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Brush.TextSecundar}">
                    <Run Text="Ultima citire:"/>
                    <Run Text="{Binding UltimaCitire, Mode=OneWay}"/>
                </TextBlock>
                <Button Content="Citește acum" Command="{Binding CitesteAcumCommand}"/>
                <Button Content="Configurația implicită" Command="{Binding ImpliciteCommand}"
                        ToolTip="Revine la cele 4 zone implicite (nu salvează automat)"/>
                <Button Content="Reîncarcă" Command="{Binding ReincarcaCommand}"
                        ToolTip="Renunță la modificări și citește din nou fișierul"/>
                <Button Content="Salvează" Command="{Binding SalveazaCommand}" FontWeight="SemiBold"
                        ToolTip="{Binding MotivSalvare}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sera Inteligentă" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Configurarea serei, validarea parcelelor și monitorizarea pe zone"
                               Foreground="{StaticResource Brush.TextSecundar}"/>
                </StackPanel>
                <!-- Starea generală: culoare + simbol + text, ca să nu depindă doar de culoare -->
                <Border Style="{StaticResource Insigna}" Margin="20,0,0,0" Padding="10,4"
                        Background="{Binding StareGenerala, Converter={StaticResource SeveritateBrush}, ConverterParameter=fundal}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Simbol}" Margin="0,0,6,0"
                                   Text="{Binding StareGenerala, Converter={StaticResource SeveritateSimbol}}"
                                   Foreground="{Binding StareGenerala, Converter={StaticResource SeveritateBrush}}"/>
                        <TextBlock Text="{Binding StareGeneralaText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{Binding StareGenerala, Converter={StaticResource SeveritateBrush}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- ================= Conținut ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>

            <!-- Coloana stângă: seră, hartă, probleme -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <!-- Dimensiunile serei -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Dimensiunile serei" Style="{StaticResource TitluSectiune}"/>
                        <WrapPanel>
                            <StackPanel Width="120" Margin="0,0,12,0">
                                <TextBlock Text="Lungime (m)" Style="{StaticResource Eticheta}"/>
                                <TextBox Text="{Binding SeraLungimeText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Lungimea serei în metri"/>
                            </StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,0">
                                <TextBlock Text="Lățime (m)" Style="{StaticResource Eticheta}"/>
                                <TextBox Text="{Binding SeraLatimeText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Lățimea serei în metri"/>
                            </StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,0">
                                <TextBlock Text="Înălțime (m)" Style="{StaticResource Eticheta}"/>
                                <TextBox Text="{Binding SeraInaltimeText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Înălțimea serei în metri"/>
                            </StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,0">
                                <TextBlock Text="Lățime alei (m)" Style="{StaticResource Eticheta}"/>
                                <TextBox Text="{Binding LatimeAleeText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Lățimea aleilor în metri"
                                         ToolTip="Aleile de pe margini, dintre coloane și dintre rânduri. Recomandat: cel puțin 0,8 m."/>
                            </StackPanel>
                            <StackPanel Width="140" Margin="0,0,12,0">
                                <TextBlock Text="Culoare minime (%)" Style="{StaticResource Eticheta}"/>
                                <TextBox Text="{Binding ProcentCuloarText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Procentul minim pentru culoare de acces"
                                         ToolTip="Ce procent din seră trebuie să rămână liber pentru acces"/>
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="Suprafață totală" Style="{StaticResource Eticheta}"/>
                                <TextBlock Text="{Binding SuprafataTotalaText}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="Volum de aer" Style="{StaticResource Eticheta}"/>
                                <TextBlock Text="{Binding VolumText}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="Ocupat de parcele" Style="{StaticResource Eticheta}"/>
                                <TextBlock Text="{Binding SuprafataOcupataText}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eticheta}">
                                    <Run Text="Culoare de acces,"/>
                                    <Run Text="{Binding CuloareMinimText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding CuloareText}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Harta serei -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Rectangle Width="14" Height="14" Fill="{StaticResource Brush.Alee}" Stroke="{StaticResource Brush.Perete}" Margin="0,0,4,0"/>
                                <TextBlock Text="Alei" Foreground="{StaticResource Brush.TextSecundar}" Margin="0,0,14,0"/>
                                <Rectangle Width="14" Height="14" Stroke="{StaticResource Brush.Ok}" StrokeThickness="2" Margin="0,0,4,0"/>
                                <TextBlock Text="Fără probleme" Foreground="{StaticResource Brush.TextSecundar}" Margin="0,0,14,0"/>
                                <Rectangle Width="14" Height="14" Stroke="{StaticResource Brush.Avertisment}" StrokeThickness="2" Margin="0,0,4,0"/>
                                <TextBlock Text="Avertisment" Foreground="{StaticResource Brush.TextSecundar}" Margin="0,0,14,0"/>
                                <Rectangle Width="14" Height="14" Stroke="{StaticResource Brush.Eroare}" StrokeThickness="2" Margin="0,0,4,0"/>
                                <TextBlock Text="Eroare" Foreground="{StaticResource Brush.TextSecundar}" Margin="0,0,14,0"/>
                                <Ellipse Width="12" Height="12" Fill="{StaticResource Brush.SenzorClimat}" Stroke="White" StrokeThickness="1.5" Margin="0,0,4,0"/>
                                <TextBlock Text="Stație climat" Foreground="{StaticResource Brush.TextSecundar}" Margin="0,0,14,0"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.SenzorSol}" Stroke="White" StrokeThickness="1.5" Margin="0,0,4,0"/>
                                <TextBlock Text="Sol" Foreground="{StaticResource Brush.TextSecundar}" Margin="0,0,14,0"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.SenzorLumina}" Stroke="#7A5A00" StrokeThickness="1" Margin="0,0,4,0"/>
                                <TextBlock Text="Lumină" Foreground="{StaticResource Brush.TextSecundar}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource TitluSectiune}" Margin="0">
                                <Run Text="Harta serei"/>
                                <Run Text="– vedere de sus, la scară; clic pe o parcelă ca să o selectezi" FontWeight="Normal" FontSize="12"
                                     Foreground="{StaticResource Brush.TextSecundar}"/>
                            </TextBlock>
                        </DockPanel>

                        <!-- Aerul serei: comun tuturor parcelelor, măsurat de stațiile de climat -->
                        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Info.Fundal}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <WrapPanel>
                                <TextBlock Text="Aerul serei (comun)" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                    <TextBlock Text="Temperatură " VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecundar}"/>
                                    <TextBlock Text="{Binding ClimatTemperaturaText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding ClimatTemperaturaStare, Converter={StaticResource StareValoareBrush}}"/>
                                    <TextBlock Text="{Binding ClimatTemperaturaDetaliu}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextSecundar}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                    <TextBlock Text="Umiditate " VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecundar}"/>
                                    <TextBlock Text="{Binding ClimatUmiditateText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding ClimatUmiditateStare, Converter={StaticResource StareValoareBrush}}"/>
                                    <TextBlock Text="{Binding ClimatUmiditateDetaliu}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextSecundar}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RezumatSenzoriText}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextSecundar}"/>
                            </WrapPanel>
                        </Border>

                        <Viewbox Stretch="Uniform" Margin="4">
                            <Canvas Width="{Binding HartaLatime}" Height="{Binding HartaInaltime}">
                                <!-- Sera: tot ce nu e parcelă e alee -->
                                <Rectangle Width="{Binding SeraLatimePx}" Height="{Binding SeraInaltimePx}"
                                           Fill="{StaticResource Brush.Alee}" Stroke="{StaticResource Brush.Perete}"
                                           StrokeThickness="4" RadiusX="4" RadiusY="4"/>

                                <ItemsControl ItemsSource="{Binding Zone}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding HartaX}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding HartaY}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ButonParcela}"
                                                    Command="{Binding SelecteazaCommand}"
                                                    Width="{Binding HartaLatime}" Height="{Binding HartaInaltime}"
                                                    AutomationProperties.Name="{Binding Nume}">
                                                <Button.ToolTip>
                                                    <StackPanel MaxWidth="320">
                                                        <TextBlock Text="{Binding Nume}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding EtichetaPlante}"/>
                                                        <TextBlock>
                                                            <Run Text="{Binding DimensiuniText, Mode=OneWay}"/>
                                                            <Run Text="·"/>
                                                            <Run Text="{Binding SuprafataText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button.ToolTip>

                                                <Border CornerRadius="3" ClipToBounds="True"
                                                        BorderThickness="{Binding EsteSelectata, Converter={StaticResource SelectieGrosime}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource Brush.Sol}"/>
                                                            <Setter Property="BorderBrush" Value="{Binding NivelMaxim, Converter={StaticResource SeveritateBrush}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Incape}" Value="False">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Eroare}"/>
                                                                    <Setter Property="Opacity" Value="0.85"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="{Binding LatimeColoanaSecundara}"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Plantele „răsădite” pe parcelă -->
                                                        <Rectangle Fill="{Binding PlantaPrincipala, Converter={StaticResource PlantaModel}}"/>
                                                        <Rectangle Grid.Column="1" Fill="{Binding PlantaSecundara, Converter={StaticResource PlantaModel}}"/>
                                                        <Rectangle Grid.Column="1" Width="2" HorizontalAlignment="Left" Fill="#CCFFFFFF"/>

                                                        <!-- Parcela iese din seră: hașură roșie peste ea -->
                                                        <Rectangle Grid.ColumnSpan="2" Fill="#55C62828">
                                                            <Rectangle.Style>
                                                                <Style TargetType="Rectangle">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Incape}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Rectangle.Style>
                                                        </Rectangle>

                                                        <!-- Eticheta parcelei -->
                                                        <Border Grid.ColumnSpan="2" Background="#EBFFFFFF" CornerRadius="4"
                                                                Margin="6" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Nume}" FontWeight="SemiBold" FontSize="12"/>
                                                                <TextBlock Text="{Binding EtichetaPlante}" FontSize="11"/>
                                                                <TextBlock Text="{Binding RezumatSenzori}" FontSize="11"
                                                                           Foreground="{StaticResource Brush.TextSecundar}"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Simbolul problemei celei mai grave -->
                                                        <Border Grid.ColumnSpan="2" Width="24" Height="24" CornerRadius="12" Margin="6"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Background="{Binding NivelMaxim, Converter={StaticResource SeveritateBrush}}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding NivelMaxim}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Style="{StaticResource Simbol}" HorizontalAlignment="Center" Foreground="White" FontSize="12"
                                                                       Text="{Binding NivelMaxim, Converter={StaticResource SeveritateSimbol}}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Senzorii, poziționați după dimensiunile serei și ale parcelelor -->
                                <ItemsControl ItemsSource="{Binding SenzoriHarta}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="{Binding Marime}" Height="{Binding Marime}" ToolTip="{Binding Descriere}"
                                                     AutomationProperties.Name="{Binding Descriere}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.SenzorSol}"/>
                                                        <Setter Property="Stroke" Value="White"/>
                                                        <Setter Property="StrokeThickness" Value="2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tip}" Value="climat">
                                                                <Setter Property="Fill" Value="{StaticResource Brush.SenzorClimat}"/>
                                                                <Setter Property="StrokeThickness" Value="3"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tip}" Value="lumina">
                                                                <Setter Property="Fill" Value="{StaticResource Brush.SenzorLumina}"/>
                                                                <Setter Property="Stroke" Value="#7A5A00"/>
                                                                <Setter Property="StrokeThickness" Value="1.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Viewbox>
                    </DockPanel>
                </Border>

                <!-- Probleme și jurnal -->
                <TabControl Grid.Row="4" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Chenar}">
                    <TabItem>
                        <TabItem.Header>
                            <TextBlock>
                                <Run Text="Rezultatul validării ("/><Run Text="{Binding Probleme.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </TabItem.Header>
                        <ListBox ItemsSource="{Binding Probleme}" SelectedItem="{Binding ProblemaSelectata}"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Lista problemelor de validare">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Simbol}" VerticalAlignment="Top" Margin="0,2,0,0"
                                                   Text="{Binding Nivel, Converter={StaticResource SeveritateSimbol}}"
                                                   Foreground="{Binding Nivel, Converter={StaticResource SeveritateBrush}}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Mesaj}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Recomandare}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{StaticResource Brush.TextSecundar}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Recomandare}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <TextBlock>
                                <Run Text="Senzori ("/><Run Text="{Binding SenzoriHarta.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </TabItem.Header>
                        <ListView ItemsSource="{Binding SenzoriHarta}" BorderThickness="0" FontSize="12"
                                  AutomationProperties.Name="Lista senzorilor din seră">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Senzor" Width="70" DisplayMemberBinding="{Binding Id}"/>
                                    <GridViewColumn Header="Tip" Width="115" DisplayMemberBinding="{Binding TipText}"/>
                                    <GridViewColumn Header="Poziție" Width="95" DisplayMemberBinding="{Binding PozitieText}"/>
                                    <GridViewColumn Header="Valori" Width="260" DisplayMemberBinding="{Binding Valori}"/>
                                    <GridViewColumn Header="Folosită pentru (pondere la estimare)" Width="300" DisplayMemberBinding="{Binding Folosire}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="Jurnal evenimente">
                        <ListBox ItemsSource="{Binding Jurnal}" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Coloana dreaptă: zonele -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Zone de cultură" Style="{StaticResource TitluSectiune}" Margin="2,0,0,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Zone}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="12" Margin="0,0,4,10" BorderThickness="1.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Chenar}"/>
                                                <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsteSelectata}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                                        <Setter Property="Background" Value="{StaticResource Brush.Accent.Fundal}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <!-- Antetul zonei -->
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Simbol}" FontSize="16"
                                                           Text="{Binding NivelMaxim, Converter={StaticResource SeveritateSimbol}}"
                                                           Foreground="{Binding NivelMaxim, Converter={StaticResource SeveritateBrush}}"/>
                                                <Image DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,8,0"
                                                       Source="{Binding PlantaPrincipala, Converter={StaticResource PlantaIcon}}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nume}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Foreground="{StaticResource Brush.TextSecundar}" FontSize="12">
                                                        <Run Text="{Binding DimensiuniText, Mode=OneWay}"/>
                                                        <Run Text="·"/>
                                                        <Run Text="{Binding SuprafataText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Dimensiuni -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Lungime (m)" Style="{StaticResource Eticheta}"/>
                                                    <TextBox Text="{Binding LungimeText, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Lungimea parcelei în metri"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Lățime (m)" Style="{StaticResource Eticheta}"/>
                                                    <TextBox Text="{Binding LatimeText, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Lățimea parcelei în metri"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Plante -->
                                            <TextBlock Text="Plantă principală" Style="{StaticResource Eticheta}"/>
                                            <ComboBox ItemsSource="{Binding DataContext.Plante, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="IdPlanta"
                                                      SelectedValue="{Binding PlantaPrincipalaId}"
                                                      AutomationProperties.Name="Planta principală"
                                                      Margin="0,0,0,6">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Width="18" Height="18" Margin="0,0,6,0"
                                                                   Source="{Binding Converter={StaticResource PlantaIcon}}"/>
                                                            <TextBlock Text="{Binding Nume}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBlock Text="Plantă secundară (opțional)" Style="{StaticResource Eticheta}"/>
                                            <ComboBox ItemsSource="{Binding DataContext.PlanteSecundare, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="IdPlanta"
                                                      SelectedValue="{Binding PlantaSecundaraId}"
                                                      AutomationProperties.Name="Planta secundară"
                                                      Margin="0,0,0,10">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Width="18" Height="18" Margin="0,0,6,0"
                                                                   Source="{Binding Converter={StaticResource PlantaIcon}}"/>
                                                            <TextBlock Text="{Binding Nume}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <!-- Senzori -->
                                            <ItemsControl ItemsSource="{Binding Senzori}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource Brush.Fundal}" CornerRadius="6" Padding="8,6" Margin="0,0,6,6">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Eticheta}" Style="{StaticResource Eticheta}" Margin="0"/>
                                                                <TextBlock Text="{Binding ValoareText}" FontSize="16" FontWeight="SemiBold"
                                                                           Foreground="{Binding Stare, Converter={StaticResource StareValoareBrush}}"/>
                                                                <TextBlock Text="{Binding Detaliu}" FontSize="11" Foreground="{StaticResource Brush.TextSecundar}" TextWrapping="Wrap"/>
                                                                <TextBlock FontSize="11" Foreground="{StaticResource Brush.TextSecundar}" TextWrapping="Wrap">
                                                                    <Run Text="{Binding IntervalText, Mode=OneWay}"/>
                                                                    <Run Text="{Binding StareText, Mode=OneWay}" FontWeight="SemiBold"
                                                                         Foreground="{Binding Stare, Converter={StaticResource StareValoareBrush}}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Problemele zonei -->
                                            <ItemsControl ItemsSource="{Binding Probleme}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="6" Padding="8,5" Margin="0,0,6,4"
                                                                Background="{Binding Nivel, Converter={StaticResource SeveritateBrush}, ConverterParameter=fundal}">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Simbol}" FontSize="12"
                                                                           VerticalAlignment="Top" Margin="0,2,8,0"
                                                                           Text="{Binding Nivel, Converter={StaticResource SeveritateSimbol}}"
                                                                           Foreground="{Binding Nivel, Converter={StaticResource SeveritateBrush}}"/>
                                                                <TextBlock Text="{Binding Mesaj}" TextWrapping="Wrap" FontSize="12"/>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
