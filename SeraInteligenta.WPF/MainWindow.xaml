<Window x:Class="SeraInteligenta.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sera Inteligentă - Monitorizare și Configurare pe 4 Zone" 
        Height="860" Width="1200" MinHeight="720" MinWidth="1020"
        Background="#0B1120" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Resurse Paletă Dark Theme cu Contrast Înalt (Elimină 100% fundalul alb/gri din Windows) -->
        <SolidColorBrush x:Key="DarkBg" Color="#0B1120"/>
        <SolidColorBrush x:Key="CardBg" Color="#131D31"/>
        <SolidColorBrush x:Key="ControlDarkBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="ControlDarkBorder" Color="#334155"/>
        <SolidColorBrush x:Key="TextLight" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

        <!-- ControlTemplate pentru ToggleButton-ul din ComboBox (garantează fundal închis fără gri deschis nativ) -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot" 
                    Background="#0F172A" 
                    BorderBrush="#475569" 
                    BorderThickness="1.5" 
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <!-- Săgeată dropdown (Chevron) -->
                    <Path x:Name="Arrow" 
                          Grid.Column="1" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z" 
                          Fill="#94A3B8"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#38BDF8"/>
                    <Setter TargetName="TemplateRoot" Property="Background" Value="#1E293B"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#38BDF8"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#38BDF8"/>
                    <Setter TargetName="TemplateRoot" Property="Background" Value="#1E293B"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#38BDF8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Stil ComboBox complet personalizat cu ControlTemplate propriu (OverridesDefaultStyle) -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Butonul principal care asigură fundalul negru/albastru închis #0F172A -->
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>

                            <!-- Conținutul selecției curente afișat în ComboBox -->
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="10,4,30,4" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"/>

                            <!-- Popup-ul cu lista tuturor celor 10 specii din catalog -->
                            <Popup Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="260">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#0F172A" 
                                            BorderBrush="#38BDF8" 
                                            BorderThickness="1.5" 
                                            CornerRadius="6" 
                                            Margin="0,3,0,0">
                                        <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stil ComboBoxItem pentru fiecare opțiune din listă (fundal închis, hover albastru) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" 
                                Padding="8,6" 
                                Background="#0F172A" 
                                BorderThickness="0,0,0,1" 
                                BorderBrush="#1E293B" 
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Șablon vizual comun pentru fiecare plantă din ComboBox (arată nume, categorie și ținte) -->
        <DataTemplate x:Key="PlantItemTemplate">
            <StackPanel Margin="0,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Nume}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11"/>
                    <TextBlock Text=" · " Foreground="#64748B" FontSize="11"/>
                    <TextBlock Text="{Binding Categorie}" Foreground="#94A3B8" FontSize="10" FontStyle="Italic"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Țintă: " Foreground="#64748B" FontSize="10"/>
                    <TextBlock Text="{Binding UmiditateOptima, StringFormat='{}{0}% umid'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding LuminaOptima, StringFormat='{}{0} Lux'}" Foreground="#FBBF24" FontWeight="SemiBold" FontSize="10"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Rând 0: Titlu și Buton Citire Globală -->
            <RowDefinition Height="Auto"/>
            <!-- Rând 1: Cele 4 Zone pe Ecran (Grid 2x2) -->
            <RowDefinition Height="*"/>
            <!-- Rând 2: Panoul de Jos cu Datele Comune ale Serei și Validare -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Rând 0: Antet -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Sera Inteligentă" FontSize="18" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="· Monitorizare Simultana 4 Zone (Milestone 1)" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Name="BtnCitesteTotiSenzorii" Content="Citește Toți Senzorii (4 Zone)" Click="BtnCitesteTotiSenzorii_Click"
                            Background="#059669" Foreground="White" FontWeight="Bold" Padding="14,6" Cursor="Hand" Margin="0,0,10,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Rând 1: Grid cu Cele 4 Zone (2 x 2) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ZONA 1 (Stânga-Sus) -->
            <Border Grid.Row="0" Grid.Column="0" Background="#131D31" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,6,6">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="ZONA 1 - PARCELA NORD" FontWeight="Bold" Foreground="#38BDF8" FontSize="13"/>
                        <TextBlock Name="TxtZ1Suprafata" Text="50.0 m² (17.4%)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Parcelă: " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Name="TxtZ1L" Text="10.0" Width="36" Background="#0B1120" Foreground="White" FontSize="11" Margin="0,0,2,0"/>
                        <TextBlock Text="m x " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Name="TxtZ1l" Text="5.0" Width="36" Background="#0B1120" Foreground="White" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="Set" Click="BtnAplicaDimensiuniZone_Click" Padding="6,1" FontSize="10" Background="#1E293B" Foreground="#38BDF8"/>
                    </StackPanel>

                    <TextBlock Text="Alege Planta din Catalog (JSON):" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox Name="CmbZ1Planta" SelectionChanged="CmbPlanta_SelectionChanged" Tag="1" Margin="0,0,0,8" 
                              ItemTemplate="{StaticResource PlantItemTemplate}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TxtZ1TintaUmid" Text="Umiditate Țintă: 65%" Foreground="#38BDF8" FontSize="11" Grid.Column="0"/>
                        <TextBlock Name="TxtZ1TintaLux" Text="Lumină Țintă: 600 Lux" Foreground="#FBBF24" FontSize="11" Grid.Column="1"/>
                    </Grid>

                    <Border Background="#0B1120" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Senzor Umiditate" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Name="TxtZ1ValUmid" Text="--.-- %" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Senzor Lumină" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Name="TxtZ1ValLux" Text="---- Lux" FontSize="16" FontWeight="Bold" Foreground="#FBBF24"/>
                            </StackPanel>
                            <Button Content="Citește" Click="BtnCitesteZona_Click" Tag="1" Grid.Column="2" Padding="8,4" VerticalAlignment="Center" Background="#0284C7" Foreground="White" FontSize="10"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ZONA 2 (Dreapta-Sus) -->
            <Border Grid.Row="0" Grid.Column="1" Background="#131D31" BorderBrush="#FBBF24" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="6,0,0,6">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="ZONA 2 - PARCELA EST" FontWeight="Bold" Foreground="#FBBF24" FontSize="13"/>
                        <TextBlock Name="TxtZ2Suprafata" Text="50.0 m² (17.4%)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Parcelă: " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Name="TxtZ2L" Text="10.0" Width="36" Background="#0B1120" Foreground="White" FontSize="11" Margin="0,0,2,0"/>
                        <TextBlock Text="m x " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Name="TxtZ2l" Text="5.0" Width="36" Background="#0B1120" Foreground="White" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="Set" Click="BtnAplicaDimensiuniZone_Click" Padding="6,1" FontSize="10" Background="#1E293B" Foreground="#FBBF24"/>
                    </StackPanel>

                    <TextBlock Text="Alege Planta din Catalog (JSON):" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox Name="CmbZ2Planta" SelectionChanged="CmbPlanta_SelectionChanged" Tag="2" Margin="0,0,0,8"
                              ItemTemplate="{StaticResource PlantItemTemplate}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TxtZ2TintaUmid" Text="Umiditate Țintă: 80%" Foreground="#38BDF8" FontSize="11" Grid.Column="0"/>
                        <TextBlock Name="TxtZ2TintaLux" Text="Lumină Țintă: 750 Lux" Foreground="#FBBF24" FontSize="11" Grid.Column="1"/>
                    </Grid>

                    <Border Background="#0B1120" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Senzor Umiditate" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Name="TxtZ2ValUmid" Text="--.-- %" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Senzor Lumină" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Name="TxtZ2ValLux" Text="---- Lux" FontSize="16" FontWeight="Bold" Foreground="#FBBF24"/>
                            </StackPanel>
                            <Button Content="Citește" Click="BtnCitesteZona_Click" Tag="2" Grid.Column="2" Padding="8,4" VerticalAlignment="Center" Background="#D97706" Foreground="White" FontSize="10"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ZONA 3 (Stânga-Jos) -->
            <Border Grid.Row="1" Grid.Column="0" Background="#131D31" BorderBrush="#A78BFA" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,6,6,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="ZONA 3 - PARCELA SUD" FontWeight="Bold" Foreground="#A78BFA" FontSize="13"/>
                        <TextBlock Name="TxtZ3Suprafata" Text="50.0 m² (17.4%)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Parcelă: " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Name="TxtZ3L" Text="10.0" Width="36" Background="#0B1120" Foreground="White" FontSize="11" Margin="0,0,2,0"/>
                        <TextBlock Text="m x " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Name="TxtZ3l" Text="5.0" Width="36" Background="#0B1120" Foreground="White" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="Set" Click="BtnAplicaDimensiuniZone_Click" Padding="6,1" FontSize="10" Background="#1E293B" Foreground="#A78BFA"/>
                    </StackPanel>

                    <TextBlock Text="Alege Planta din Catalog (JSON):" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox Name="CmbZ3Planta" SelectionChanged="CmbPlanta_SelectionChanged" Tag="3" Margin="0,0,0,8"
                              ItemTemplate="{StaticResource PlantItemTemplate}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TxtZ3TintaUmid" Text="Umiditate Țintă: 55%" Foreground="#38BDF8" FontSize="11" Grid.Column="0"/>
                        <TextBlock Name="TxtZ3TintaLux" Text="Lumină Țintă: 350 Lux" Foreground="#FBBF24" FontSize="11" Grid.Column="1"/>
                    </Grid>

                    <Border Background="#0B1120" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Senzor Umiditate" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Name="TxtZ3ValUmid" Text="--.-- %" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Senzor Lumină" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Name="TxtZ3ValLux" Text="---- Lux" FontSize="16" FontWeight="Bold" Foreground="#FBBF24"/>
                            </StackPanel>
                            <Button Content="Citește" Click="BtnCitesteZona_Click" Tag="3" Grid.Column="2" Padding="8,4" VerticalAlignment="Center" Background="#7C3AED" Foreground="White" FontSize="10"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ZONA 4 (Dreapta-Jos) -->
            <Border Grid.Row="1" Grid.Column="1" Background="#131D31" BorderBrush="#34D399" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="6,6,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="ZONA 4 - PARCELA VEST" FontWeight="Bold" Foreground="#34D399" FontSize="13"/>
                        <TextBlock Name="TxtZ4Suprafata" Text="50.0 m² (17.4%)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Parcelă: " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Name="TxtZ4L" Text="10.0" Width="36" Background="#0B1120" Foreground="White" FontSize="11" Margin="0,0,2,0"/>
                        <TextBlock Text="m x " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Name="TxtZ4l" Text="5.0" Width="36" Background="#0B1120" Foreground="White" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="Set" Click="BtnAplicaDimensiuniZone_Click" Padding="6,1" FontSize="10" Background="#1E293B" Foreground="#34D399"/>
                    </StackPanel>

                    <TextBlock Text="Alege Planta din Catalog (JSON):" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox Name="CmbZ4Planta" SelectionChanged="CmbPlanta_SelectionChanged" Tag="4" Margin="0,0,0,8"
                              ItemTemplate="{StaticResource PlantItemTemplate}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TxtZ4TintaUmid" Text="Umiditate Țintă: 60%" Foreground="#38BDF8" FontSize="11" Grid.Column="0"/>
                        <TextBlock Name="TxtZ4TintaLux" Text="Lumină Țintă: 650 Lux" Foreground="#FBBF24" FontSize="11" Grid.Column="1"/>
                    </Grid>

                    <Border Background="#0B1120" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Senzor Umiditate" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Name="TxtZ4ValUmid" Text="--.-- %" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Senzor Lumină" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Name="TxtZ4ValLux" Text="---- Lux" FontSize="16" FontWeight="Bold" Foreground="#FBBF24"/>
                            </StackPanel>
                            <Button Content="Citește" Click="BtnCitesteZona_Click" Tag="4" Grid.Column="2" Padding="8,4" VerticalAlignment="Center" Background="#059669" Foreground="White" FontSize="10"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Rând 2: Panoul de Jos cu DATELE COMUNE ale Serei și VALIDARE STRICTĂ -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Date Geometrice + Jurnal -->
                    <RowDefinition Height="Auto"/>
                    <!-- Alertă Validare Full-Width -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Coloana 0: Dimensiuni Globale Seră -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,10">
                    <TextBlock Text="DIMENSIUNI GLOBALE SERĂ (m):" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="L:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBox Name="TxtSeraL" Text="24.0" Width="40" Background="#0B1120" Foreground="White" Margin="0,0,6,0"/>
                        <TextBlock Text="l:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBox Name="TxtSeral" Text="12.0" Width="40" Background="#0B1120" Foreground="White" Margin="0,0,6,0"/>
                        <TextBlock Text="h:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBox Name="TxtSerah" Text="3.8" Width="40" Background="#0B1120" Foreground="White" Margin="0,0,8,0"/>
                        <Button Content="Aplică Seră" Click="BtnAplicaSera_Click" Padding="8,2" Background="#0284C7" Foreground="White" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Name="TxtInfoSeraComun" Text="Suprafață Totală: 288.0 m² | Volum Aer: 1094.4 m³" Foreground="#94A3B8" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Coloana 1: Culoare & Procente de Ocupare -->
                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,10">
                    <TextBlock Name="TxtInfoOcupare" Text="Ocupat de cele 4 zone: 200.0 m² (69.4%)" Foreground="#FBBF24" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Name="TxtInfoCuloar" Text="Spațiu Culoare Acces: 88.0 m² (30.6%) - Prag minim: 15% (43.2 m²)" Foreground="#34D399" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Coloana 2: Jurnal Evenimente -->
                <Border Grid.Row="0" Grid.Column="2" Background="#0B1120" CornerRadius="6" Padding="6" BorderBrush="#334155" BorderThickness="1" Height="75" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Name="TxtJurnal" Background="Transparent" Foreground="#94A3B8" FontFamily="Consolas" FontSize="10" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

                <!-- Rândul 1 (Full Width): Panoul Dedicat de Validare cu TextWrapping complet (fără tăiere text) -->
                <Border Name="BorderValidare" Grid.Row="1" Grid.ColumnSpan="3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Name="BadgeStatusContainer" Background="#059669" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
